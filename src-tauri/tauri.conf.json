{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RimeTools",
  "version": "0.1.0",
  "identifier": "com.rimetools.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RimeTools",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "跨平台 Rime 词库管理工具",
    "longDescription": "面向小狼毫与 fcitx5-rime 用户的个人词库工作台：词库维护、编码建议、备份恢复、一键部署。"
  }
}
